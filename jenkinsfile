pipeline{
    agent any
    stages{
        stage('Build'){
            steps{
                echo 'Building...'
            }
        }
        stage('Test'){
            steps{
                withCredentials([usernamePassword(
                          credentialsId: 'docker-sec',
                          usernameVariable: 'USER',
                          passwordVariable: 'PASS')]) {
                          echo 'deploy.sh $USER $PASS'
                        }

                echo 'Testing...'
            }
        }
        stage('Deploy'){
            steps{
                echo 'Deploying...'
            }
        }
    }
    post{
        always{
            echo 'This will always run'
        }
        success{
            echo 'This will run only if successful'
        }
        failure{
            echo 'This will run only if failed'
        }
    }

}
